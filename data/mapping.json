  "transforms_registry": {
    "_comment": "Tất cả các hàm transform được tham chiếu trong config này. Implement trong transforms.js",

    "none": {
      "description": "Giữ nguyên giá trị, không biến đổi."
    },
    "phone_vn": {
      "description": "Chuẩn hóa số điện thoại Việt Nam về dạng 10 số, bắt đầu bằng 0.",
      "example": "+84901234567 → 0901234567 | 84901234567 → 0901234567"
    },
    "digits_only": {
      "description": "Chỉ giữ lại ký tự số, loại bỏ tất cả ký tự khác.",
      "example": "+84-901.234.567 → 84901234567"
    },
    "to_string": {
      "description": "Chuyển number/boolean sang string để điền vào input.",
      "example": "123 → '123'"
    },
    "format_date": {
      "description": "Chuyển đổi định dạng ngày. Input: ISO string hoặc Date object. Output: theo outputFormat.",
      "params": { "outputFormat": "DD/MM/YYYY | YYYY-MM-DD | MM/DD/YYYY" },
      "example": "2026-05-12 → 12/05/2026 (với outputFormat DD/MM/YYYY)"
    },
    "computed_date": {
      "description": "Tính ngày từ ngày hiện tại (today) cộng offset. Không cần input từ Master Form.",
      "params": {
        "offset_days": "Số ngày cộng thêm (default: 0)",
        "offset_years": "Số năm cộng thêm (default: 0)",
        "outputFormat": "DD/MM/YYYY"
      },
      "example": "today + offset_years:5 → 12/05/2031"
    },
    "map_value": {
      "description": "Tra bảng key-value để đổi giá trị. Fallback: giữ nguyên nếu không có trong map.",
      "params": { "map": "object key→value" }
    },
    "extract_last_n_chars": {
      "description": "Đọc string, lấy n ký tự cuối cùng.",
      "params": { "n": "Số ký tự cần lấy" },
      "example": "IMEI: 'ABC123456789' với n=9 → '456789' (9 ký tự cuối)"
    }
  },

  "error_handling": {
    "on_selector_not_found": "screenshot → log error → throw để dừng form hiện tại, không ảnh hưởng form khác",
    "on_transform_fail": "log warning với giá trị gốc → dùng giá trị gốc (graceful degradation)",
    "on_submit_timeout": "screenshot → retry 1 lần sau 3s → nếu vẫn fail thì throw",
    "screenshot_on_error": true,
    "screenshot_path": "./logs/errors/",
    "log_path": "./logs/runs/"
  }
}
