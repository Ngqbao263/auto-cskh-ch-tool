{
  "_meta": {
    "version": "1.0.0",
    "description": "Mapping config cho hệ thống Auto Data Entry: CSKH (SDVICO) & Cấu hình (Viettel)",
    "last_updated": "2026-05-12",
    "author": "Auto-generated từ Master Form survey",
    "targets": ["cskh", "cauhinh"],
    "notes": [
      "Cấu hình Viettel gồm 5 form con (form1..form5) phải điền tuần tự.",
      "CSKH là 1 form duy nhất.",
      "Tất cả selector nên dùng fallback chain (mảng) để chịu được thay đổi UI nhỏ.",
      "action_type quyết định cách Playwright tương tác với element."
    ]
  },

  "_action_types_reference": {
    "fill": "page.fill() — input/textarea thông thường",
    "fill_then_tab": "fill() rồi nhấn Tab để kích hoạt sự kiện onchange/onblur của web",
    "combobox_search": "click mở dropdown -> type để tìm kiếm -> Enter để chọn kết quả đầu tiên",
    "datepicker_radix": "KHÔNG gõ text. click button -> Dialog lịch xuất hiện -> điều hướng tháng/năm -> click ô ngày",
    "select_native": "page.selectOption() — thẻ <select> HTML tiêu chuẩn",
    "custom_select": "Thử page.selectOption() trên thẻ <select> ẩn; fallback: click mở menu -> click item text",
    "checkbox_click": "click() để toggle; kiểm tra trạng thái trước khi click để đảm bảo đúng state",
    "extract_and_fill": "Đọc value từ selector_source -> transform -> điền vào selector_dest",
    "static_fill": "Luôn điền một giá trị cố định, bỏ qua Master Form input",
    "computed_date": "Tính ngày dựa trên today() + offset, theo format chỉ định",
    "conditional_fill": "Chỉ điền khi điều kiện (condition_field) thoả mãn; chờ element enabled trước"
  },

