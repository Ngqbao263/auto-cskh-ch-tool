  "targets": {
    "cskh": {
      "_comment": "Web CSKH (SDVICO) — 1 form đơn. Nhiều selector dùng placeholder vì thiếu id/name.",
      "form_structure": "single_form",

      "fields": {
        "ship_code": {
          "master_field": "ship_code",
          "label_vi": "Mã tàu",
          "action_type": "combobox_search",
          "selector": {
            "trigger_button": [
              "button[role='combobox']:has-text('Nhập mã tàu')",
              "//label[contains(.,'Mã tàu')]/following-sibling::button[@role='combobox']",
              "button[role='combobox']:near(:text('Mã tàu'))"
            ],
            "search_input": [
              "input[role='combobox']",
              "[cmdk-input]",
              "input[placeholder*='Tìm']"
            ]
          },
          "transform": "none",
          "notes": "Button text thực tế là 'Nhập mã tàu...' — dùng :has-text() làm primary. XPath dùng contains() vì label có thể có asterisk (*) nối thêm."
        },

        "serial_number": {
          "master_field": "serial_number",
          "label_vi": "Serial Number",
          "action_type": "combobox_search",
          "selector": {
            "trigger_button": [
              "button[role='combobox']:has-text('Chọn Serial Number')",
              "//label[contains(.,'Serial Number')]/following-sibling::button[@role='combobox']",
              "button[role='combobox']:near(:text('Serial Number'))"
            ],
            "search_input": ["input[role='combobox']", "[cmdk-input]"]
          },
          "transform": "none",
          "notes": "Button text thực tế là 'Chọn Serial Number...' — dùng :has-text() làm primary. Label chứa <span>*</span> nên XPath dùng contains(). Button là sibling trực tiếp của label, không có div trung gian."
        },

        "owner_name": {
          "master_field": "owner_name",
          "label_vi": "Tên chủ tàu",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Nhập tên chủ tàu']",
            "//label[contains(.,'Tên chủ tàu')]/following-sibling::input"
          ],
          "transform": "none"
        },

        "owner_phone": {
          "master_field": "owner_phone",
          "label_vi": "SĐT chủ tàu",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Nhập số điện thoại chủ tàu']",
            "//label[contains(.,'SĐT chủ tàu')]/following-sibling::input"
          ],
          "transform": "phone_vn"
        },

        "owner_cccd": {
          "master_field": "owner_cccd",
          "label_vi": "CCCD chủ tàu",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Nhập số CCCD chủ tàu']",
            "//label[contains(.,'CCCD')]/following-sibling::input"
          ],
          "transform": "none"
        },

        "owner_address": {
          "master_field": "owner_address",
          "label_vi": "Địa chỉ chủ tàu",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Số nhà, đường, phường/xã, huyện/thị xã, tỉnh/thành phố chủ tàu']",
            "//label[contains(.,'Địa chỉ')][1]/following-sibling::input"
          ],
          "transform": "none"
        },

        "captain_is_owner": {
          "master_field": "captain_is_owner",
          "label_vi": "Thuyền trưởng là Chủ tàu (checkbox)",
          "action_type": "checkbox_click",
          "selector": [
            "button[role='checkbox']:near(:text('Thuyền trưởng là Chủ tàu'))",
            "input[type='checkbox']:near(:text('Thuyền trưởng là Chủ tàu'))",
            "//label[contains(.,'Thuyền trưởng là Chủ tàu')]//button[@role='checkbox']"
          ],
          "transform": "none",
          "logic": "Nếu master_field = true: click để check (nếu chưa checked). Nếu false: đảm bảo unchecked, bỏ qua phần điền captain bên dưới."
        },

        "captain_name": {
          "master_field": "captain_name",
          "label_vi": "Tên thuyền trưởng",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Nhập tên thuyền trưởng']",
            "//label[contains(.,'Tên thuyền trưởng')]/following-sibling::input"
          ],
          "transform": "none",
          "conditional": "Chỉ điền khi captain_is_owner = false"
        },

        "captain_phone": {
          "master_field": "captain_phone",
          "label_vi": "SĐT thuyền trưởng",
          "action_type": "fill",
          "selector": ["input[placeholder='Nhập số điện thoại thuyền trưởng']"],
          "transform": "phone_vn",
          "conditional": "Chỉ điền khi captain_is_owner = false"
        },

        "captain_cccd": {
          "master_field": "captain_cccd",
          "label_vi": "CCCD thuyền trưởng",
          "action_type": "fill",
          "selector": ["input[placeholder='Nhập số CCCD thuyền trưởng']"],
          "transform": "none",
          "conditional": "Chỉ điền khi captain_is_owner = false"
        },

        "captain_address": {
          "master_field": "captain_address",
          "label_vi": "Địa chỉ thuyền trưởng",
          "action_type": "fill",
          "selector": [
            "input[placeholder='Số nhà, đường, phường/xã, huyện/thị xã, tỉnh/thành phố thuyền trưởng']"
          ],
          "transform": "none",
          "conditional": "Chỉ điền khi captain_is_owner = false"
        },

        "requester_is_owner": {
          "master_field": "requester_is_owner",
          "label_vi": "Người yêu cầu là chủ tàu (checkbox)",
          "action_type": "checkbox_click",
          "selector": [
            "button[role='checkbox']:near(:text('Người yêu cầu là chủ tàu'))",
            "input[type='checkbox']:near(:text('Người yêu cầu là chủ tàu'))"
          ],
          "transform": "none",
          "logic": "Nếu true: click để check. Web sẽ tự điền thông tin chủ tàu vào section người yêu cầu."
        },

        "requester_name": {
          "master_field": "requester_name",
          "label_vi": "Tên người yêu cầu",
          "action_type": "combobox_search",
          "selector": {
            "trigger_button": [
              "button[role='combobox']:near(:text('Tên người yêu cầu'))",
              "//label[contains(.,'Tên người yêu cầu')]/following-sibling::button[@role='combobox']"
            ],
            "search_input": ["input[role='combobox']", "[cmdk-input]"]
          },
          "transform": "none",
          "conditional": "Chỉ điền khi requester_is_owner = false"
        },

        "so_thang": {
          "master_field": "so_thang",
          "label_vi": "Số tháng",
          "action_type": "fill",
          "selector": [
            "//label[contains(.,'Số tháng')]/following-sibling::input[@type='number']",
            "//label[contains(.,'Số tháng')]/following::input[@type='number'][1]"
          ],
          "transform": "to_string",
          "pre_action": "clear",
          "notes": "QUAN TRỌNG: Ô có giá trị mặc định = 3. Phải gọi clear() trước fill() để xóa giá trị cũ."
        },

        "loai_khuyen_mai": {
          "master_field": "loai_khuyen_mai",
          "label_vi": "Loại khuyến mãi",
          "action_type": "custom_select",
          "selector": {
            "hidden_select": [
              "select:near(:text('Loại khuyến mãi'))",
              "//label[contains(.,'Loại khuyến mãi')]/following-sibling::select"
            ],
            "trigger_button": [
              "button[role='combobox']:near(:text('Loại khuyến mãi'))"
            ],
            "option_text_pattern": "Sẽ được resolve từ value_map"
          },
          "transform": "map_value",
          "transformOptions": {
            "map": {
              "none": "Không có",
              "fixed": "Tiền mặt (VNĐ)",
              "percent": "Phần trăm (%)",
              "month": "Tặng tháng"
            }
          },
          "strategy": "Thử 1: page.selectOption() trên hidden_select. Thử 2 (fallback): click trigger_button -> click item có text = giá trị đã map."
        },

        "gia_tri_khuyen_mai": {
          "master_field": "gia_tri_khuyen_mai",
          "label_vi": "Giá trị khuyến mãi",
          "action_type": "conditional_fill",
          "selector": [
            "input[placeholder='Nhập giá trị']",
            "//label[contains(.,'Giá trị KM')]/following-sibling::input"
          ],
          "transform": "to_string",
          "condition": {
            "field": "loai_khuyen_mai",
            "operator": "not_equals",
            "value": "none"
          },
          "wait_for_enabled": true,
          "notes": "Chỉ điền khi loai_khuyen_mai != none. Phải waitFor({ state: 'enabled' }) vì ô này bị disabled khi KM = none."
        }
      }
    },

    "cauhinh": {
      "_comment": "Web Cấu hình (Viettel) — Gồm 5 form con, điền tuần tự. Mỗi form có selector rõ ràng với id.",
      "form_structure": "multi_step",
      "forms": {
        "form1": {
          "_name": "Thông tin thiết bị (Device Info)",
          "_comment": "Các trường cơ bản về thiết bị. Date fields điền ĐẦU TIÊN để calendar tự đóng khi click vào field tiếp theo.",

          "fields": {
            "date_manufacture": {
              "master_field": null,
              "label_vi": "Ngày sản xuất (Form 1)",
              "action_type": "computed_date",
              "selector": ["#dateManufacture"],
              "transform": "computed_date",
              "transformOptions": {
                "offset_days": 0,
                "outputFormat": "DD/MM/YYYY"
              },
              "notes": "Điền ĐẦU TIÊN để calendar tự đóng khi bot click vào field tiếp theo."
            },
            "end_manufacture": {
              "master_field": null,
              "label_vi": "Ngày hết hạn (Form 1)",
              "action_type": "computed_date",
              "selector": ["#endManufacture"],
              "transform": "computed_date",
              "transformOptions": {
                "offset_years": 5,
                "outputFormat": "DD/MM/YYYY"
              },
              "notes": "Điền ngày hiện tại + 5 năm."
            },
            "device_name": {
              "master_field": "ship_code",
              "label_vi": "Tên thiết bị",
              "action_type": "fill",
              "selector": ["input#deviceName", "#deviceName"],
              "transform": "none"
            },
            "species": {
              "master_field": null,
              "label_vi": "Chủng loại",
              "action_type": "static_fill",
              "selector": ["#species"],
              "static_value": "S-Tracking",
              "transform": "none"
            },
            "frequency": {
              "master_field": null,
              "label_vi": "Tần số",
              "action_type": "static_fill",
              "selector": ["#frequency"],
              "static_value": "120Hz",
              "transform": "none"
            },
            "fw_version": {
              "master_field": null,
              "label_vi": "Phiên bản phần cứng",
              "action_type": "static_fill",
              "selector": ["#fwversion"],
              "static_value": "v1.0",
              "transform": "none"
            }
          }
        },

        "form2": {
          "_name": "Thông tin thuyền trưởng (Captain)",

          "fields": {
            "captain_birthday": {
              "master_field": "captain_birthday",
              "label_vi": "Ngày sinh thuyền trưởng",
              "action_type": "fill",
              "selector": ["#birthdayCaptain"],
              "transform": "none",
              "required": false,
              "notes": "Điền ĐẦU TIÊN để calendar tự đóng khi bot click vào field tiếp theo. Format: DD/MM/YYYY."
            },
            "captain_name": {
              "master_field": "captain_name",
              "label_vi": "Họ và tên thuyền trưởng",
              "action_type": "fill",
              "selector": ["#captainDevice", "input#captainDevice"],
              "transform": "none",
              "copy_from_owner_if": "captain_is_owner",
              "copy_source_field": "owner_name",
              "notes": "Nếu captain_is_owner=true, copy giá trị từ owner_name."
            },
            "captain_phone": {
              "master_field": "captain_phone",
              "label_vi": "Số điện thoại thuyền trưởng",
              "action_type": "fill",
              "selector": ["#phoneCaptain1"],
              "transform": "phone_vn",
              "copy_from_owner_if": "captain_is_owner",
              "copy_source_field": "owner_phone"
            },
            "captain_cccd": {
              "master_field": "captain_cccd",
              "label_vi": "Số CMND thuyền trưởng",
              "action_type": "fill",
              "selector": ["#cmndCaptain"],
              "transform": "none",
              "copy_from_owner_if": "captain_is_owner",
              "copy_source_field": "owner_cccd"
            },
            "captain_address": {
              "master_field": "captain_address",
              "label_vi": "Địa chỉ thuyền trưởng",
              "action_type": "fill",
              "selector": ["#addressCaptain"],
              "transform": "none",
              "copy_from_owner_if": "captain_is_owner",
              "copy_source_field": "owner_address"
            },
            "captain_gender": {
              "master_field": "captain_gender",
